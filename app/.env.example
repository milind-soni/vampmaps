# Required for production builds. Point at the published HTTPS manifest.
EXPO_PUBLIC_COVERAGE_MANIFEST_URL=https://cdn.example.com/vamp/coverage/manifest.json

# Optional. Enables queued generation requests when no published pack covers
# the selected map view. This is a full POST endpoint, not the static catalog.
EXPO_PUBLIC_COVERAGE_REQUEST_URL=https://api.example.com/v1/coverage-requests
