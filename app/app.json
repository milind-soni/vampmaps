{
  "expo": {
    "name": "ShadeMax",
    "slug": "shademax",
    "version": "1.0.0",
    "icon": "./assets/vamp-sun-horizon-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.milindsoni.shademax",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShadeMax uses your location to start shade routes from where you're standing."
      }
    },
    "android": {
      "package": "com.milindsoni.shademax",
      "adaptiveIcon": {
        "backgroundColor": "#4E234B",
        "foregroundImage": "./assets/vamp-sun-horizon-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/vamp-sun-horizon-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/vamp-sun-horizon-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F2",
          "dark": {
            "backgroundColor": "#141214"
          }
        }
      ]
    ]
  }
}
